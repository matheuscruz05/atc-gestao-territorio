# Configuração de Exemplo para Google Sheets

# ============================================
# GOOGLE SHEETS CONFIGURATION (REQUIRED)
# ============================================

# ID da planilha Google Sheets
# Copie da URL: https://docs.google.com/spreadsheets/d/[AQUI]/edit
EXPO_PUBLIC_GOOGLE_SHEETS_ID=seu_spreadsheet_id_aqui

# Opção A: API Key (apenas leitura, mais simples)
# Gere em: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_SHEETS_API_KEY=AIzaSy_sua_chave_de_api_aqui

# Opção B: Service Account (leitura e escrita automática)
# Não necessário se usar Opção A + compartilhar planilha
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ============================================
# WEBHOOK (OPCIONAL)
# ============================================

# URL do webhook para notificações em tempo real
# Configure em Google Sheets > Extensões > Apps Script
# EXPO_PUBLIC_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec

# ============================================
# SERVIDOR
# ============================================

# Porta do servidor (padrão: 3000)
PORT=3000

# NODE Environment
NODE_ENV=development

# ============================================
# NOTAS
# ============================================
# 1. Copie este arquivo para .env.local
# 2. Preencha com seus valores reais
# 3. Nunca commite .env.local no Git
# 4. Verifique GOOGLE_SHEETS_SETUP.md para instruções detalhadas
